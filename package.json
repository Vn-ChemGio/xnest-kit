{
  "name": "xnest-kit",
  "version": "0.0.3",
  "description": "A modular, production-ready NestJS toolkit — Bootstrap, Auth, SaaS, and Infra integrations in a single package.",
  "keywords": [
    "nestjs",
    "nest-kit",
    "toolkit",
    "bootstrap",
    "swagger",
    "openapi",
    "scalar",
    "cache",
    "redis",
    "valkey",
    "keyv",
    "typeorm",
    "orm",
    "database",
    "queue",
    "bullmq",
    "authentication",
    "authorization",
    "rbac",
    "pbac",
    "jwt",
    "session",
    "api-key",
    "password",
    "bcrypt",
    "oauth",
    "sso",
    "saas",
    "multi-tenant",
    "guard",
    "decorator",
    "webhook",
    "rate-limit",
    "notification",
    "email",
    "sms",
    "push",
    "activity-feed",
    "audit",
    "logger",
    "pino",
    "metrics",
    "prometheus",
    "storage",
    "s3",
    "gcs",
    "azure",
    "stripe",
    "excel",
    "xlsx",
    "csv",
    "security",
    "typescript",
    "nodejs",
    "backend",
    "framework"
  ],
  "author": "Wind Blade <vn.chemgio@yahoo.com>",
  "private": false,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./swagger": {
      "types": "./dist/swagger/index.d.ts",
      "default": "./dist/swagger/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./typeorm": {
      "types": "./dist/typeorm/index.d.ts",
      "default": "./dist/typeorm/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./notification": {
      "types": "./dist/notification/index.d.ts",
      "default": "./dist/notification/index.js"
    },
    "./notification/typeorm": {
      "types": "./dist/notification/typeorm/index.d.ts",
      "default": "./dist/notification/typeorm/index.js"
    },
    "./notification/channel/*": {
      "types": "./dist/notification/channels/*/index.d.ts",
      "default": "./dist/notification/channels/*/index.js"
    },
    "./activity-feed": {
      "types": "./dist/activity-feed/index.d.ts",
      "default": "./dist/activity-feed/index.js"
    },
    "./audit-log": {
      "types": "./dist/audit-log/index.d.ts",
      "default": "./dist/audit-log/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/index.d.ts",
      "default": "./dist/rate-limit/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe/index.d.ts",
      "default": "./dist/stripe/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook/index.d.ts",
      "default": "./dist/webhook/index.js"
    },
    "./excel": {
      "types": "./dist/excel/index.d.ts",
      "default": "./dist/excel/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vn-ChemGio/xnest-kit.git"
  },
  "homepage": "https://github.com/Vn-ChemGio/xnest-kit#readme",
  "bugs": {
    "url": "https://github.com/Vn-ChemGio/xnest-kit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:all": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --passWithNoTests --watch",
    "test:cov": "jest --passWithNoTests --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docs:serve": "http-server docs -p 4000 -c-1",
    "docs:open": "open http://localhost:4000",
    "prepublishOnly": "npm run build:all",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@keyv/valkey": ">=1.0.0",
    "@nestjs/cache-manager": ">=3.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@nestjs/swagger": ">=11.0.0",
    "@nestjs/typeorm": ">=10.0.0",
    "@scalar/nestjs-api-reference": ">=1.0.0",
    "cache-manager": ">=6.0.0",
    "class-validator": ">=0.14.0",
    "keyv": ">=5.0.0",
    "reflect-metadata": ">=0.1.0",
    "rxjs": ">=7.0.0",
    "typeorm": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": false
    },
    "@nestjs/core": {
      "optional": false
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "@nestjs/typeorm": {
      "optional": true
    },
    "@nestjs/cache-manager": {
      "optional": true
    },
    "@keyv/valkey": {
      "optional": true
    },
    "@scalar/nestjs-api-reference": {
      "optional": true
    },
    "cache-manager": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "keyv": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": false
    },
    "rxjs": {
      "optional": false
    },
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@keyv/valkey": "^1.0.11",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "@scalar/nestjs-api-reference": "^1.2.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "cache-manager": "^7.2.9",
    "class-validator": "^0.15.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "jest": "^30.0.0",
    "keyv": "^5.6.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.0",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^1.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
